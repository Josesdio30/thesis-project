# Database Configuration
DB_HOST=${DB_HOST}
DB_PORT=${DB_PORT}
DB_NAME=${DB_NAME}
DB_USER=${DB_USER}
DB_PASSWORD=${DB_PASSWORD}

# Database URL for Prisma
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
NEXTAUTH_SECRET=
NEXTAUTH_URL=
# Copy to .env.local and fill in private values. Never commit real credentials.
# Next.js: shell/deployment > .env.<mode>.local > .env.local > .env.<mode> > .env.
# .env.local is skipped in test mode. This template and .env.backup are not loaded.

# Main LMS database: Prisma and the login route use DATABASE_URL.
# Replace the placeholders with URL-encoded credentials.
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/YOUR_LMS_DATABASE
# Used by LMS helpers; falls back to DATABASE_URL when empty.
LMS_POSTGRES_URL=
# Auxiliary AI database (pgvector); required for AI configuration and storage.
AUX_POSTGRES_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/YOUR_AUX_DATABASE
# false for local Postgres without TLS; unset uses NODE_ENV-based behavior.
POSTGRES_SSL=false

# Authentication uses these POSTGRES_* settings directly (lib/db.ts).
# Point them at the same main LMS database as DATABASE_URL.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=YOUR_LMS_DATABASE
POSTGRES_USER=YOUR_DB_USER
POSTGRES_PASSWORD=

# Fallback for lib/database.ts when neither LMS_POSTGRES_URL nor DATABASE_URL is set.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=YOUR_LMS_DATABASE
DB_USER=YOUR_DB_USER
DB_PASSWORD=

# Authentication: generate NEXTAUTH_SECRET with `openssl rand -base64 32`.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
# Optional: defaults to NEXTAUTH_SECRET. Keep stable to decrypt stored AI keys.
# CREDENTIAL_ENCRYPTION_SECRET=

# AI provider: local (Ollama) or openai. The code defaults to openai if unset.
AI_PROVIDER=local
LOCAL_SYSTEM_PROMPT_FILE=prompts/grading-system-prompt-local-v2.txt
# Optional prompt override for both providers; the local-specific file wins locally.
# GRADING_PROMPT_FILE=
# Disable thinking for local models that otherwise exhaust the output budget.
OLLAMA_THINK=false

# Optional Ollama overrides: env > local_ai_config database row > code defaults.
# Leave commented to preserve settings managed in the admin UI.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=qwen2.5:14b-instruct-q4_K_M
# OLLAMA_EMBED_MODEL=bge-m3
# OLLAMA_EMBED_DIMS=1024
# OLLAMA_NUM_CTX=8192
# OLLAMA_NUM_PREDICT=1536
# OLLAMA_KEEP_ALIVE=30m
# LOCAL_RAG_TOP_K=6
# LOCAL_LLM_CONCURRENCY=1
# LOCAL_EMBED_CONCURRENCY=2
# LOCAL_SCORING_MODE=holistic

# OpenAI provider only; an admin-managed credential takes precedence.
OPENAI_API_KEY=

# Optional Supabase-to-aux migration script (not needed for normal app startup).
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional validation scripts; use dedicated validation accounts.
# BASE_URL=http://localhost:3000
# RUN_USER=val_teacher
# RUN_PASS=
# VAL_TEACHER_PASS=
# VAL_STUDENT_PASS=
# ADMIN_USER=
# ADMIN_PASS=
