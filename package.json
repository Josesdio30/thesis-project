{
  "name": "thesis-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "node scripts/env-run.mjs node_modules/prisma/build/index.js generate",
    "db:pull": "node scripts/env-run.mjs node_modules/prisma/build/index.js db pull",
    "db:push": "node scripts/env-run.mjs node_modules/prisma/build/index.js db push",
    "db:studio": "node scripts/env-run.mjs node_modules/prisma/build/index.js studio",
    "db:migrate": "node scripts/env-run.mjs node_modules/prisma/build/index.js migrate deploy",
    "db:status": "node scripts/env-run.mjs node_modules/prisma/build/index.js migrate status",
    "db:bootstrap": "node scripts/setup/bootstrap.mjs",
    "db2:migrate": "node db/ai-db/migrate.mjs",
    "db2:migrate-supabase": "node scripts/migrate-db2-from-supabase.mjs",
    "db2:init": "node db/ai-db/migrate.mjs --init",
    "test": "jest",
    "test:setup": "node --test scripts/setup/*.test.mjs",
    "env:run": "node scripts/env-run.mjs"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "@next/env": "15.2.3",
    "@prisma/client": "^6.8.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.86.0",
    "@tiptap/pm": "^2.13.0",
    "@tiptap/react": "^2.13.0",
    "@tiptap/starter-kit": "^2.13.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/crypto-js": "^4.2.2",
    "@types/pg": "^8.15.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "exceljs": "4.4.0",
    "fflate": "^0.8.3",
    "franc-min": "^6.2.0",
